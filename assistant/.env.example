# --- Assistant service ---
PORT=8787
# Comma separated list of allowed browser origins (the CRM frontend)
ASSISTANT_CORS_ORIGIN=http://localhost:5173

# --- Supabase (server side) ---
SUPABASE_URL=http://127.0.0.1:54321
# Direct Postgres connection; the service runs user-scoped queries as the
# `authenticated` role with RLS, and reads assistant credentials as postgres.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# Optional HS256 fallback for legacy Supabase projects (JWT secret):
# SUPABASE_JWT_SECRET=

# --- pi-durable storage ---
ASSISTANT_SQLITE_PATH=./data/assistant.sqlite

# --- BYOK encryption (REQUIRED) ---
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means stored provider keys must be re-entered.
ASSISTANT_ENCRYPTION_KEY=

# --- Model limits for BYOK (OpenAI-compatible endpoints) ---
ASSISTANT_CONTEXT_WINDOW=128000
ASSISTANT_MAX_OUTPUT_TOKENS=8192
ASSISTANT_MAX_TURNS=24
