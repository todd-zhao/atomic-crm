# Copy to deploy/assistant.env and fill in. NEVER commit assistant.env.
# CORS: the public origin of the CRM (used by the browser to reach /assistant).
ASSISTANT_CORS_ORIGIN=https://crm.example.com

# Supabase project (cloud).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Direct Postgres connection. Use the pooler URL when the VPS has no IPv6:
#   postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# or the direct one:
#   postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Optional: defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Keep a backup: without it the stored BYOK keys cannot be decrypted.
ASSISTANT_ENCRYPTION_KEY=

# Model limits for BYOK endpoints.
ASSISTANT_CONTEXT_WINDOW=128000
ASSISTANT_MAX_OUTPUT_TOKENS=8192
ASSISTANT_MAX_TURNS=24
